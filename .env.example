# Upstash Redis — required for online multiplayer in production (Vercel).
# Create a free database at https://console.upstash.com/ and copy the
# "REST API" credentials below. Locally the app falls back to an in-memory
# store if these are not set (works for a single dev server only).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
